# =============================================================================
# TAGS Agency OS — Environment Variables
# =============================================================================
# Copy this file to .env and fill in your keys.
#   cp .env.example .env
# -----------------------------------------------------------------------------

# ── Provider #1: Groq (default — free, fast) ────────────────────────────────
# Sign up: https://console.groq.com
GROQ_API_KEY=your_groq_api_key_here

# LiteLLM model strings (you usually DON'T need to change these):
# AGENCY_CEO_MODEL=groq/llama-3.3-70b-versatile
# WORKSPACE_AGENT_MODEL=groq/llama-3.1-8b-instant

# ── Provider #2: Google Gemini (free tier) ──────────────────────────────────
# Get key: https://aistudio.google.com/apikey
# GEMINI_API_KEY=your_gemini_api_key_here
# AGENCY_CEO_MODEL=gemini/gemini-2.0-flash
# WORKSPACE_AGENT_MODEL=gemini/gemini-2.0-flash

# ── Provider #3: OpenRouter (has free models too) ──────────────────────────
# Sign up: https://openrouter.ai/
# OPENROUTER_API_KEY=your_openrouter_key_here
# AGENCY_CEO_MODEL=openrouter/meta-llama/llama-3.3-70b-instruct
# WORKSPACE_AGENT_MODEL=openrouter/meta-llama/llama-3.1-8b-instruct

# ── Advanced: Manual API key/base overrides ─────────────────────────────────
# Only set these if your provider needs a custom base URL or separate keys.
# AGENCY_CEO_API_KEY=
# AGENCY_CEO_API_BASE=
# WORKSPACE_API_KEY=
# WORKSPACE_API_BASE=

# ── LiteLLM proxy (optional) ───────────────────────────────────────────────
# Route ALL chat requests through a local LiteLLM proxy (e.g. localhost:4000).
# LITELLM_PROXY_URL=http://localhost:4000

# ── Server ──────────────────────────────────────────────────────────────────
# ADMIN_HOST=0.0.0.0
# ADMIN_PORT=9002

# ── EC2 backend (frontend proxy target) ─────────────────────────────────────
# EC2_BACKEND_URL=http://18.213.66.136:8000

# ── PostgreSQL ──────────────────────────────────────────────────────────────
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/tags_agency

# ---
# SBA Lead-to-Meeting Pipeline - Email & Calendar
# ---
# SBA uses these to send/receive lead emails and create calendar invites.
# For Gmail, use an App Password: https://myaccount.google.com/apppasswords
SBA_OWNER_EMAIL=your_owner_email@gmail.com
SBA_OWNER_EMAIL_PASSWORD=your_app_password_here
SBA_SMTP_SERVER=smtp.gmail.com
SBA_SMTP_PORT=587
SBA_IMAP_SERVER=imap.gmail.com
SBA_IMAP_PORT=993
# SBA Behaviour
SBA_CHECK_INTERVAL=3600
SBA_MAX_LEADS_PER_CYCLE=5
