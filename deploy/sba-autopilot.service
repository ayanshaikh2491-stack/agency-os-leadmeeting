# deploy/sba-autopilot.service
[Unit]
Description=SBA 24/7 Autopilot (always-on lead/email/meeting loop)
After=network.target

[Service]
Type=simple
WorkingDirectory=/home/ubuntu/sba-backend
EnvironmentFile=/home/ubuntu/sba-backend/.env
ExecStart=/home/ubuntu/sba-backend/venv/bin/python -m admin.agency.sba_autopilot
# CPU-safe restart: the autopilot has its own inner per-pass try/except + an
# outer retry/backoff guard, so it should never hard-crash. If it does, back
# off (30s) and stop after 5 fails in 5 min instead of tight-looping the CPU.
Restart=on-failure
RestartSec=30
StartLimitIntervalSec=300
StartLimitBurst=5
User=root

[Install]
WantedBy=multi-user.target
