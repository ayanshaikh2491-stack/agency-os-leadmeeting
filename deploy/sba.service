# deploy/sba.service — SBA Backend (TAGS Agency)
# Hardened 2026-08-15 after an incident: a missing module in a deploy bundle
# made admin.main crash at import, and "Restart=always" + "RestartSec=5"
# tight-looped the process 2000+ times, pegging the CPU and hanging the box.
#
# Fixes:
#  - Restart=on-failure (don't restart on a clean/intended exit)
#  - RestartSec=30  (wait 30s between restarts instead of 5s)
#  - StartLimitIntervalSec + StartLimitBurst = give up after 5 fails in 5min
#    so a wedged process can't burn CPU forever; `systemctl reset-failed
#    sba.service` clears the limit after the root cause is fixed.
[Unit]
Description=SBA Backend (TAGS Agency)
After=network.target
# Give up after 5 failed starts within 5 min so a wedged process can't burn
# CPU forever. `systemctl reset-failed sba.service` clears this after the
# root cause is fixed.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/sba-backend
Environment=PYTHONPATH=/home/ubuntu/sba-backend
ExecStart=/home/ubuntu/sba-backend/venv/bin/python -m admin.main
Restart=on-failure
RestartSec=30
StandardOutput=append:/var/log/sba.log
StandardError=append:/var/log/sba.log

[Install]
WantedBy=multi-user.target
