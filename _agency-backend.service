[Unit]
Description=AI Marketing Agency Backend
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/agency-platform/backend
EnvironmentFile=/home/ubuntu/agency-platform/backend/.env
Environment=PATH=/home/ubuntu/agency-platform/backend/venv/bin:/home/ubuntu/.local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
Environment=PYTHONPATH=/home/ubuntu/agency-platform/backend/venv/lib/python3.12/site-packages
ExecStart=/home/ubuntu/.local/bin/gunicorn main:app -k uvicorn.workers.UvicornWorker -w 1 --bind 0.0.0.0:8000 --max-requests 1000 --max-requests-jitter 50 --timeout 300 --access-logfile /home/ubuntu/agency-platform/backend/access.log --error-logfile /home/ubuntu/agency-platform/backend/error.log
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
